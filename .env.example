NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Newer Supabase projects may use PUBLISHABLE_KEY instead of ANON_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key
# Vertex AI embeddings (uses gcloud ADC instead of the AI Studio key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Chat model (gemini-2.0-flash often has free-tier limit 0)
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Alternatives: gemini-2.5-flash-lite, gemini-3-flash-preview
# Longer catch-up answers (default 4096)
GEMINI_MAX_OUTPUT_TOKENS=4096

# --- Chunking ---
# structural (default) splits on scene break > paragraph > line > sentence.
# semantic splits where consecutive sentence windows drift apart in embedding
# space; far more accurate, but embeds every sentence window during ingest.
CHUNK_STRATEGY=structural
CHUNK_TARGET_CHARS=1800
CHUNK_MIN_CHARS=500
CHUNK_MAX_CHARS=2600
CHUNK_OVERLAP_CHARS=250
# Semantic-only knobs
SEMANTIC_BUFFER_SIZE=1
SEMANTIC_PERCENTILE=90

# --- Hybrid retrieval ---
# Candidates pulled from each of dense + BM25 before Reciprocal Rank Fusion
RETRIEVAL_CANDIDATES=40
# Chunks kept for the answer context
RETRIEVAL_FINAL_CHUNKS=12
# RRF smoothing constant
RRF_K=60
# Dense floor is low on purpose; RRF and reranking do the filtering
DENSE_MATCH_THRESHOLD=0.3
# Log per-chunk ranks and scores for every query
RETRIEVAL_DEBUG=false

# --- Cross-encoder reranking ---
# cohere | jina | tei | gemini | none. Unset auto-detects from the keys below
# and falls back to none. Reranking failures degrade to plain fusion order.
# RERANK_PROVIDER=cohere
# Fused candidates scored by the cross-encoder before trimming to
# RETRIEVAL_FINAL_CHUNKS
RERANK_CANDIDATES=40
RERANK_TIMEOUT_MS=8000
# Cohere Rerank
# COHERE_API_KEY=your-cohere-key
# COHERE_RERANK_MODEL=rerank-v3.5
# Jina Reranker
# JINA_API_KEY=your-jina-key
# JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# Self-hosted BGE-Reranker behind HuggingFace Text Embeddings Inference
# RERANK_ENDPOINT=http://localhost:8080
# RERANK_API_KEY=optional-bearer-token
# Gemini listwise fallback: opt-in only, spends chat quota per query
# GEMINI_RERANK_MODEL=gemini-2.5-flash-lite
# RERANK_DOC_CHARS=1500

# --- CRAG (corrective retrieval + grounding) ---
# Post-retrieval grader. If confidence is below the threshold, expand the
# query and re-retrieve; if still weak, fall back to spoiler-filtered web search.
CRAG_ENABLED=true
CRAG_CONFIDENCE_THRESHOLD=0.55
CRAG_RELEVANCE_THRESHOLD=0.5
CRAG_WEB_SEARCH=true
# Optional Tavily key; otherwise Gemini Google Search is used
# TAVILY_API_KEY=your-tavily-key
# GEMINI_CRAG_MODEL=gemini-2.5-flash-lite
# CRAG_WEB_RESULTS=5
# CRAG_GRADE_TIMEOUT_MS=8000
# CRAG_EXPAND_TIMEOUT_MS=8000
# CRAG_WEB_TIMEOUT_MS=10000

# --- Rate Limiting ---
# Per-user request limits to stay within AI Studio free-tier quotas.
# Each chat request can trigger 2-4 internal Gemini calls, so user-facing
# limits are set conservatively below the raw API caps.
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY=15
