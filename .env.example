NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Newer Supabase projects may use PUBLISHABLE_KEY instead of ANON_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key
# Chat model (gemini-2.0-flash often has free-tier limit 0)
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Alternatives: gemini-2.5-flash-lite, gemini-3-flash-preview
# Longer catch-up answers (default 4096)
GEMINI_MAX_OUTPUT_TOKENS=4096
